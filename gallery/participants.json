{
    "format": "block_dash",
    "version": 1,
    "requires": [
        "block_dash"
    ],
    "name": "Course participants",
    "config": {
        "title": "Participants",
        "data_source_idnumber": "block_dash\\local\\data_source\\users_data_source",
        "preferences": {
            "layout": "block_dash\\local\\layout\\cards_layout",
            "headingfield": "u_fullname",
            "subheadingfield": "u_email",
            "imageurlfield": "u_picture_url",
            "columns": 3,
            "perpage": 12,
            "filters": {
                "participants": {
                    "enabled": 1
                }
            }
        },
        "showheader": 1,
        "width": 100,
        "hide_when_empty": 0,
        "emptystate": {
            "text": "This course has no participants yet.",
            "format": "1"
        }
    },
    "files": [],
    "datasource_data": []
}
