{{!
    @template block_dash/gallery_options

    The gallery items to pick from, for the pickers.

    Context variables required for this template:
    * items - Items, each with shortname, name, description and source.

    Example context (json):
    {
        "items": [
            {"shortname": "block_dash:my-learning", "name": "My learning", "description": "Your courses.", "source": "Dash"}
        ]
    }
}}
<div class="list-group" role="listbox" aria-label="{{#str}} gallery, block_dash {{/str}}">
    {{#items}}
    <button type="button" class="list-group-item list-group-item-action" role="option" aria-selected="false"
        data-picker-option="{{shortname}}" data-description="{{description}}" data-search="{{name}} {{description}} {{source}}">
        <span class="d-flex align-items-center">
            <span class="flex-grow-1">
                <strong class="d-block">{{name}}</strong>
                <small class="text-muted">{{source}}</small>
            </span>
            <span class="d-md-none">{{#pix}} i/next, core {{/pix}}</span>
        </span>
    </button>
    {{/items}}
</div>
