{{!
    @template block_dash/gallery_picker

    Body of the "Choose from gallery" modal: the items on the left, a live preview on the right.

    Context variables required for this template:
    * hasitems - Whether there are items to choose from.
    * items - Items, each with shortname, name, description and source.

    Example context (json):
    {
        "hasitems": true,
        "items": [
            {"shortname": "block_dash:my-learning", "name": "My learning", "description": "Your courses.", "source": "Dash"}
        ]
    }
}}
<div class="block-dash-gallery-picker row">
    <div class="col-md-4 col-xl-3 mb-3" data-region="picker-list">
        {{#hasitems}}
        <input type="search" class="form-control mb-2" data-gallery-search
            placeholder="{{#str}} gallerysearch, block_dash {{/str}}" aria-label="{{#str}} gallerysearch, block_dash {{/str}}">
        {{> block_dash/gallery_options }}
        {{/hasitems}}
        {{^hasitems}}
        <p>{{#str}} gallerynoitems, block_dash {{/str}}</p>
        {{/hasitems}}
    </div>
    {{< block_dash/picker_detail }}
        {{$hint}}{{#str}} galleryselect, block_dash {{/str}}{{/hint}}
    {{/ block_dash/picker_detail }}
</div>
